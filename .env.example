# Preferred: shop-edge gateway site key. Build + Functions runtime only.
# Never expose this value to the browser or commit it.
SHOP_EDGE_SITE_KEY=
SHOP_EDGE_SITE_ORIGIN=https://oudyn.com

# Fallback when SHOP_EDGE_SITE_KEY is not configured.
# Required at build time and in Pages Functions runtime; never expose to the browser.
EMDASH_READ_TOKEN=
EMDASH_MERCHANT_ID=mch_oudyn

# Optional EmDash overrides.
EMDASH_API_URL=https://emd.aaaaaaaa.bid/_emdash/api/content/products
EMDASH_ASSET_BASE=https://emd.aaaaaaaa.bid

# Optional: keep original EmDash covers. Leave unset while images are placeholders.
EMDASH_USE_SOURCE_IMAGES=0

# Canonical site URL (optional; defaults to https://www.oudyn.com).
NEXT_PUBLIC_SITE_URL=https://www.oudyn.com

# Contact enquiries are written to a Cloudflare KV namespace named OUDYN_KV.
# Create the binding in the Pages dashboard; it is not an environment variable.
