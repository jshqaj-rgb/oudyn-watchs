# Build-time API used by Next server components to prerender catalog pages.
API_URL=http://127.0.0.1:4000

# Runtime Pages Function origin for /api/catalog/* (must be public HTTPS in production).
API_ORIGIN=https://api.example.com

# EmDash catalog credentials — only on the API server, never in the browser.
EMDASH_READ_TOKEN=
EMDASH_MERCHANT_ID=mch_oudyn
# Optional overrides
EMDASH_API_URL=https://emd.aaaaaaaa.bid/_emdash/api/content/products
EMDASH_ASSET_BASE=https://emd.aaaaaaaa.bid
