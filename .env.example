# EmDash catalogue (required at build time and in Pages Functions runtime).
# Never expose this token to the browser.
EMDASH_READ_TOKEN=
EMDASH_MERCHANT_ID=mch_oudyn

# Optional EmDash overrides.
EMDASH_API_URL=https://emd.aaaaaaaa.bid/_emdash/api/content/products
EMDASH_ASSET_BASE=https://emd.aaaaaaaa.bid

# Optional: keep the original EmDash cover images instead of local display
# placeholders. Only enable if the covers are real watch photography.
EMDASH_USE_SOURCE_IMAGES=0

# Canonical site URL (optional; defaults to https://www.oudyn.com).
NEXT_PUBLIC_SITE_URL=https://www.oudyn.com

# Writes (orders / newsletter / contact) use a Cloudflare KV binding named
# OUDYN_KV, configured in the Pages dashboard. It is not an environment
# variable.
